{
  "$schema": "https://static.cloudbase.net/cli/cloudbaserc.schema.json",
  "version": "2.0",
  "envId": "activity-book-web-d7djhe7bb1e834",
  "functionRoot": "cloudfunctions",
  "functions": [
    { "name": "plutonoc-analytics-collect", "runtime": "Nodejs20.19", "handler": "index.main", "timeout": 20, "memorySize": 256, "installDependency": true },
    { "name": "plutonoc-analytics-query", "runtime": "Nodejs20.19", "handler": "index.main", "timeout": 30, "memorySize": 256, "installDependency": true },
    { "name": "plutonoc-analytics-cleanup", "runtime": "Nodejs20.19", "handler": "index.main", "timeout": 60, "memorySize": 256, "installDependency": true },
    {
      "name": "plutonoc-content-publisher",
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "timeout": 60,
      "memorySize": 256,
      "installDependency": true,
      "description": "PlutonoC 管理后台的受保护 GitHub 内容发布服务",
      "envVariables": {
        "plutonoc_github_token": "{{env.PLUTONOC_GITHUB_TOKEN}}"
      }
    }
  ],
  "app": {
    "serviceName": "plutonoc-studio",
    "framework": "static",
    "installCommand": "",
    "buildCommand": "",
    "outputDir": "./",
    "root": "work/cloudbase-admin",
    "deployPath": "/"
  }
}
